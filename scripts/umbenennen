#!/usr/bin/env python3
"""Step of the flow `umbenennen`: dry run, after-check and the name lock for the rename of a program (ADR 0080). No network, no AI.

  python3 -I scripts/umbenennen dry-run --old fs-wiki --new fs-text --repos DIR... [--catalog DIR] [--docs DIR] [--world DIR]
                                         [--retired FILE] [--keep JSON|FILE] [--allow GLOB]... [--json FILE]
  python3 -I scripts/umbenennen after   --old fs-wiki --new fs-text --repos DIR... [--catalog DIR] [--docs DIR] [--world DIR]
                                         [--retired FILE] [--keep JSON|FILE] [--allow GLOB]... [--state FILE] [--json FILE]
  python3 -I scripts/umbenennen rename  --old fs-wiki --new fs-text --repos DIR... [--keep JSON|FILE] [--allow GLOB]... [--pins]   (write mode L1, scaffold; refuses on a dirty tree; --pins = only the pin URLs, after the GitHub rename)
  python3 -I scripts/umbenennen retire  --old fs-wiki --new fs-text --retired FILE

`--repos` are checkouts (worktrees) of the repos that may name the old program: the program itself, repos that pin it, CI files.
`dry-run` only reads and writes the plan. Only files tracked in git count (`git ls-files`); untracked files that name the old name are
a warning (`untracked`), never a hit. Categories: crates `<old>-*` with their new names (Cargo.toml `name =`), `ci` (.github/), `pins`
(git URL `FreeSynergy/<old>` or dependency `<old>-*`), `catalog` (entry `id = "<old>"` in `packages.toml`, needs `replaces`),
`catalogfiles` (other lines of the catalog), `docs` (`--docs`), `source` (any other tracked text file: constants, FS_<OLD>_ROOT,
paths, messages, README), `lock` (Cargo.lock), `desktop` (*.desktop, Exec=), `outside` (every fs-* checkout in `--world`, default the
parent of the first repo, that is not among the given repos: `git grep` on origin/main, read only). A hit is a line with the name
(`fs-x`), its snake form (`fs_x`) or its env form (`FS_X`). `--keep` is a JSON list of {pattern, grund, bereich}: a hit whose
`<file> [<toml section>] <line>` matches the regular expression `pattern` is `kept` (bewusst belassen, with grund and bereich in the
JSON), every other hit stays open; a pattern that matches no hit is RED (stale). `--allow` (globs on the file) moves hits to `allowed`,
in dry-run and after. The dry run lists the open hits and is RED only for name problems and stale `keep` patterns. It is RED (rc 1) when the new name is on the
retired list (a name that was given up is never given out again, ADR 0080), when the old name is already retired, when a
directory or a catalog entry of the new name exists, or when the old and new name are equal or not of the form `fs-<x>`.
`after` is RED when any open hit is left (all categories above, outside `--keep` and `--allow`), or when the catalog entry of the new name lacks `replaces = ["<old>"]`. `retire` appends `<old> -> <new>` to the retired list; it
refuses a name that is already there. A file with the list: one `old -> new  # reason` per line, `#` starts a comment.
The GitHub rename itself is NOT done here; it is a human step after the approval gate of the flow.
`after` counts the red rounds: the state file (`--state`, default `<temp folder>/umbenennen-<old>-<new>-runde`, never in a repo) gets +1
on red and is reset on green; the output has `runde=N`. The JSON has `red`, `runde`, `plan` (open hits per category, `kept`, `allowed`, `untracked`), `problems`, `warnings`.
rc 0 = green, rc 1 = red (every problem a line `red: ...`), rc 2 = bad input (JSON with `red: null` if `--json` is given),
rc 3 = `after` red in the third round or later (escalate to the person).
"""
import argparse
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from umbenennen_lib.checks import after_problems, clashes, keep_problems, name_problems, retire  # noqa: E402
from umbenennen_lib.common import BadInput, load_keep  # noqa: E402
from umbenennen_lib.outside import outside_hits, world_dir  # noqa: E402
from umbenennen_lib.rename import rename  # noqa: E402
from umbenennen_lib.scan import CATS, scan, split  # noqa: E402
from umbenennen_lib.state import counter, private_state_dir  # noqa: E402


def write_json(path, data):
    if path:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f)


def bad(a, msg):
    print(f"bad input: {msg}")
    write_json(a.json, {"red": None, "runde": 0, "plan": {}, "problems": [f"bad input: {msg}"]})
    return 2


def make_plan(a, keep):
    hits, untracked = scan(a)
    warns = []
    if a.mode != "rename":
        out, warns = outside_hits(a)
        hits += out
    plan, kept, allowed, stale = split(hits, keep, a.allow)
    total = sum(len(v) for v in plan.values()) + len(kept) + len(allowed)
    plan.update({"kept": kept, "allowed": allowed, "untracked": untracked})
    return plan, stale, warns, total


def show(a, plan, warns):
    for key in (*CATS, "kept", "allowed", "untracked"):
        items = plan[key]
        print(f"{key}: {len(items)}")
        if a.mode == "dry-run" or key == "untracked":
            for it in items:
                print("  " + ", ".join(f"{k}={v}" for k, v in it.items()))
    for w in warns:
        print(w)
    if plan["untracked"]:
        print(f"warn: {len(plan['untracked'])} untracked lines name the old name (not in git, not counted as hits)")


def main(argv):
    p = argparse.ArgumentParser()
    p.add_argument("mode", choices=["dry-run", "after", "retire", "rename"])
    p.add_argument("--old", required=True)
    p.add_argument("--new", required=True)
    p.add_argument("--repos", nargs="*", default=[])
    p.add_argument("--catalog")
    p.add_argument("--docs")
    p.add_argument("--world")
    p.add_argument("--retired")
    p.add_argument("--keep")
    p.add_argument("--allow", action="append", default=[])
    p.add_argument("--state")
    p.add_argument("--pins", action="store_true")
    p.add_argument("--json")
    try:
        a = p.parse_args(argv)
    except SystemExit:
        return 2
    for d in [*a.repos, a.catalog, a.docs, a.world]:
        if d and not os.path.isdir(d):
            return bad(a, f"{d} is not a folder")
    if a.mode == "retire":
        return retire(a)
    try:
        keep = load_keep(a.keep)
    except BadInput as e:
        return bad(a, str(e))
    if a.mode == "rename":
        names = name_problems(a, check_retired=False)
        if names:
            print("\n".join(names))
            return 1
        return rename(a, keep)
    plan, stale, warns, total = make_plan(a, keep)
    problems = name_problems(a, check_retired=a.mode == "dry-run")
    if a.mode == "dry-run":
        problems += clashes(a) + keep_problems(stale)
        if not total:
            problems.append(f"red: nothing in the given places names {a.old!r} (wrong folders?)")
    else:
        problems += after_problems(a, plan, stale)
    show(a, plan, warns)
    for line in problems:
        print(line)
    runde = 0
    if a.mode == "after":
        try:
            state = a.state or os.path.join(private_state_dir(), f"umbenennen-{a.old}-{a.new}-runde")
            runde = counter(state, bool(problems))
        except OSError as e:
            return bad(a, f"the state file cannot be used ({e}); never green without a counter")
        print(f"runde={runde}")
    write_json(a.json, {"red": bool(problems), "runde": runde, "plan": plan, "problems": problems, "warnings": warns})
    print("red" if problems else "green")
    if not problems:
        return 0
    return 3 if runde >= 3 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
