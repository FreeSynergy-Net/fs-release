#!/usr/bin/env python3
"""Rule check: `mkdocs` is never called with -q / --quiet (a quiet build hides the WARNING lines the gate reads: a blind gate).

  python3 -I scripts/check-mkdocs-quiet [<folder or file>...]     (default: workflows scripts actions .github crates)

Red = a line where `mkdocs` is followed (in the same command, no `|`, `;`, `&` between) by `-q`, `--quiet` or a combined short flag (`-vq`, `-sq`), also behind `$MKDOCS` / `$FS_MKDOCS` and on a continuation line (`\\`), also in a Python argument list
(`"mkdocs", "build", "-q"`). rc 0 clean, rc 1 red (`red: file:line: text`), rc 2 bad input.
"""
import os
import re
import sys

MKDOCS = r"(?:mkdocs\b|\$\{?MKDOCS\b|\$\{?FS_MKDOCS\b)"  # the program name or a variable that holds it
FLAG = r"(?:--quiet|-[cdfstv]*q[cdfstv]*)"  # `-q`, `--quiet`, and combined short flags (`-vq`, `-sq`, `-qs`); letters = the short flags of mkdocs
QUIET = re.compile(rf"{MKDOCS}[^|;&\n]*?(?:^|[\s\"',(\[]){FLAG}(?=[\s\"',)\]]|$)")
SELF = {"check-mkdocs-quiet", "test_check_mkdocs_quiet.sh"}
SKIP_DIRS = {".git", "target", "node_modules", "wt"}
DEFAULT = ["workflows", "scripts", "actions", ".github", "crates"]


def files(paths):
    for p in paths:
        if os.path.isfile(p):
            yield p
            continue
        for base, dirs, names in os.walk(p):
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            for n in names:
                if n not in SELF:
                    yield os.path.join(base, n)


def main(argv):
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    paths = argv or [os.path.join(root, d) for d in DEFAULT if os.path.exists(os.path.join(root, d))]
    for p in paths:
        if not os.path.exists(p):
            print(f"bad input: {p} does not exist")
            return 2
    red = 0
    for f in sorted(set(files(paths))):
        try:
            lines = open(f, encoding="utf-8").read().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        # a line that ends in `\` goes on in the next one: the call is checked as ONE line (reported at its first line)
        joined = []
        for i, line in enumerate(lines, 1):
            if joined and joined[-1][1].endswith("\\"):
                joined[-1] = (joined[-1][0], joined[-1][1][:-1] + " " + line.strip())
            else:
                joined.append((i, line.rstrip()))
        for i, line in joined:
            if QUIET.search(line):
                print(f"red: {f}:{i}: {line.strip()}")
                red += 1
    if red:
        print(f"{red} quiet mkdocs call(s): run `mkdocs build --strict` without -q and read the WARNING / ERROR lines")
        return 1
    print("ok: no quiet mkdocs call")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
