#!/usr/bin/env python3
"""Inventory of the documentation (fs-documentation): what is orphaned, dead, doubled or stale. READ ONLY.

  python3 -I scripts/doku-bestand --docs <fs-documentation worktree> [--repo <code repo>] [--retired FILE]
        [--now YYYY-MM-DD] [--allow GLOB]... [--json FILE]
  python3 -I scripts/doku-bestand --selbsttest

Deterministic, no network, no AI, nothing is written in the docs clone (only `git for-each-ref`, `git merge-base --is-ancestor`).
Prints one JSON object on stdout (also to --json FILE). Findings only; the judgement (keep, update, merge, delete) is the step `urteil`
of the flow doku-aufraeumen, not this script.

Checks:
  verwaist        a page under docs/ (de or en) that nothing links to (no relative link in docs/, conventions/, README.md) and that is
                  not named in mkdocs.yml. index.md is never an orphan.
  tote_links      a relative Markdown link in docs/, conventions/ or README.md whose target file does not exist.
  temp            a folder named temp, tmp or .tmp, or a file ending in .tmp, .bak or ~ inside the clone (not .git, .venv, site).
  de_en_luecke    docs/de/<x>.md without docs/en/<x>.md or the other way round.
  alte_namen      an old name from --retired (lines `old -> new  # reason`; the left part) that still stands in docs/, conventions/
                  or README.md as a whole word, except in files matching --allow.
  branches_alt    a local or remote branch of the docs clone whose last commit is older than 3 days and that is NOT merged into
                  origin/main (needs the ref origin/main; without it the check is listed as not run).
  nicht_geprueft  checks this script does NOT do: ADR status lines against the code (specification, not runnable).

rc 0 = the inventory ran (findings are in the JSON, `befunde` non-empty does not change rc); rc 2 = bad input (`status: "skipped"`).
Selbsttest: --selbsttest builds a fixture in a temporary folder and checks each check once with a counter-example.
"""
import argparse
import datetime
import fnmatch
import json
import os
import re
import subprocess
import sys
import tempfile

LINK = re.compile(r"(?<!\!)\[[^\]]*\]\(([^)\s#][^)\s]*?)(?:#[^)\s]*)?(?:\s+\"[^\"]*\")?\)")
SKIP_DIRS = {".git", ".venv", "site", "node_modules"}
TEMP_DIRS = {"temp", "tmp", ".tmp"}
TEMP_SUFFIX = (".tmp", ".bak", "~")
DOC_ROOTS = ("docs", "conventions", "README.md")
NOT_RUN = "ADR status lines against the code (specification, not runnable: no script reads the code state yet)"
MAX_AGE_DAYS = 3


def walk(root):
    """Relative paths of all files under root, without the folders in SKIP_DIRS."""
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        for f in sorted(filenames):
            out.append(os.path.relpath(os.path.join(dirpath, f), root))
    return out


def doc_md_files(docs):
    """Markdown files in docs/, conventions/ and README.md, relative to the clone."""
    files = []
    for rel in walk(docs):
        if not rel.endswith(".md"):
            continue
        top = rel.split(os.sep, 1)[0]
        if top in ("docs", "conventions") or rel == "README.md":
            files.append(rel)
    return files


def read(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def link_target(rel, target):
    """The clone-relative path a relative link points to, or None for external and anchor-only links."""
    if "://" in target or target.startswith(("mailto:", "/")):
        return None
    return os.path.normpath(os.path.join(os.path.dirname(rel), target))


def find_orphans_and_dead(docs, mdfiles, nav_text):
    incoming = {}
    dead = []
    for rel in mdfiles:
        for m in LINK.finditer(read(os.path.join(docs, rel))):
            tgt = link_target(rel, m.group(1))
            if tgt is None:
                continue
            if not os.path.exists(os.path.join(docs, tgt)):
                dead.append({"datei": rel, "ziel": m.group(1)})
            else:
                incoming[tgt] = incoming.get(tgt, 0) + 1
    orphans = []
    for rel in mdfiles:
        if not rel.startswith(("docs" + os.sep, "docs/")) or os.path.basename(rel) == "index.md":
            continue
        short = rel.split(os.sep, 1)[1] if os.sep in rel else rel
        if incoming.get(rel) or short in nav_text:
            continue
        orphans.append(rel)
    return orphans, dead


def find_temp(docs):
    hits = []
    for dirpath, dirnames, filenames in os.walk(docs):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for d in dirnames:
            if d in TEMP_DIRS:
                hits.append(os.path.relpath(os.path.join(dirpath, d), docs) + "/")
        for f in filenames:
            if f.endswith(TEMP_SUFFIX):
                hits.append(os.path.relpath(os.path.join(dirpath, f), docs))
    return sorted(hits)


def find_de_en(docs):
    out = []
    for lang, other in (("de", "en"), ("en", "de")):
        base = os.path.join(docs, "docs", lang)
        if not os.path.isdir(base):
            continue
        for rel in walk(base):
            if rel.endswith(".md"):
                counter = os.path.join("docs", other, rel)
                if not os.path.exists(os.path.join(docs, counter)):
                    out.append(os.path.join("docs", lang, rel))
    return sorted(out)


def read_retired(path):
    names = []
    for line in read(path).splitlines():
        line = line.split("#", 1)[0].strip()
        if "->" in line:
            names.append(line.split("->", 1)[0].strip())
    return [n for n in names if n]


def find_old_names(docs, mdfiles, names, allow):
    hits = []
    for name in names:
        pat = re.compile(r"(?<![\w-])" + re.escape(name) + r"(?![\w-])")
        for rel in mdfiles:
            if any(fnmatch.fnmatch(rel, g) for g in allow):
                continue
            for n, line in enumerate(read(os.path.join(docs, rel)).splitlines(), 1):
                if pat.search(line):
                    hits.append({"name": name, "datei": rel, "zeile": n})
    return hits


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def find_old_branches(docs, now):
    if git(docs, "rev-parse", "--verify", "-q", "origin/main").returncode != 0:
        return None
    r = git(docs, "for-each-ref", "--format=%(committerdate:unix) %(refname:short)", "refs/heads", "refs/remotes")
    if r.returncode != 0:
        return None
    out = []
    for line in r.stdout.splitlines():
        ts, ref = line.split(" ", 1)
        if ref in ("origin/main", "origin/HEAD", "main"):
            continue
        age = (now - int(ts)) / 86400
        if age <= MAX_AGE_DAYS:
            continue
        if git(docs, "merge-base", "--is-ancestor", ref, "origin/main").returncode == 0:
            continue
        out.append({"branch": ref, "alter_tage": int(age)})
    return out


def inventory(docs, repo, retired, now, allow):
    mdfiles = doc_md_files(docs)
    mk = os.path.join(docs, "mkdocs.yml")
    nav_text = read(mk) if os.path.exists(mk) else ""
    orphans, dead = find_orphans_and_dead(docs, mdfiles, nav_text)
    names = read_retired(retired) if retired else []
    branches = find_old_branches(docs, now)
    befunde = {
        "verwaist": orphans,
        "tote_links": dead,
        "temp": find_temp(docs),
        "de_en_luecke": find_de_en(docs),
        "alte_namen": find_old_names(docs, mdfiles, names, allow),
        "branches_alt": branches if branches is not None else [],
    }
    nicht = [NOT_RUN]
    if not retired:
        nicht.append("alte Namen: keine Liste (--retired fehlt)")
    if branches is None:
        nicht.append("branches_alt: origin/main fehlt im Klon, nicht geprueft")
    return {"status": "ok", "befunde": befunde, "nicht_geprueft": nicht,
            "anzahl": sum(len(v) for v in befunde.values())}


def bad(msg):
    print(json.dumps({"status": "skipped", "fehler": msg}, ensure_ascii=False))
    return 2


def selbsttest():
    """Fixture with one finding per check and one clean page; every check must find its planted problem and not the clean one."""
    tmp = tempfile.mkdtemp(prefix="doku-bestand-selbst-")
    d = os.path.join(tmp, "docs-fixture")
    os.makedirs(os.path.join(d, "docs", "de"))
    os.makedirs(os.path.join(d, "docs", "en"))
    os.makedirs(os.path.join(d, "docs", "de", "temp"))

    def put(rel, text):
        with open(os.path.join(d, rel), "w", encoding="utf-8") as f:
            f.write(text)

    put("mkdocs.yml", "nav:\n  - Start: docs/de/start.md\n")
    put("README.md", "[start](docs/de/start.md)\n")
    put("docs/de/index.md", "# Index\n")
    put("docs/de/start.md", "# Start\n[tot](nicht-da.md) [ok](../en/gut.md)\nfs-alt-name steht hier\n")
    put("docs/de/verwaist-de.md", "# lose\n")
    put("docs/de/temp/x.md", "# Temp\n")
    put("docs/de/nur-de.md", "# Nur deutsch\n")
    put("docs/en/gut.md", "# Good\n")
    put("docs/de/gut.md", "# Gut\n")
    put("docs/en/index.md", "# Index\n")
    put("docs/en/bak.md.bak", "copy\n")
    with open(os.path.join(tmp, "retired.txt"), "w", encoding="utf-8") as f:
        f.write("# Kopf\nfs-alt-name -> fs-neu  # umbenannt\n")
    put("docs/de/erlaubt.md", "fs-alt-name in der Historie\n")
    now = int(datetime.datetime(2026, 11, 16, tzinfo=datetime.timezone.utc).timestamp())
    res = inventory(d, None, os.path.join(tmp, "retired.txt"), now, ["docs/de/erlaubt.md"])
    b = res["befunde"]
    checks = [
        (any(x == os.path.join("docs", "de", "verwaist-de.md") for x in b["verwaist"]), "verwaist: lose Seite gefunden"),
        (not any("start.md" in x for x in b["verwaist"]), "verwaist: verlinkte und navigierte Seite nicht gemeldet"),
        (not any("index.md" in x for x in b["verwaist"]), "verwaist: index.md nie gemeldet"),
        (any(x["ziel"] == "nicht-da.md" for x in b["tote_links"]), "tote_links: fehlendes Ziel gefunden"),
        (not any(x["ziel"] == "../en/gut.md" for x in b["tote_links"]), "tote_links: vorhandenes Ziel nicht gemeldet"),
        (any(x.startswith("docs/de/temp") for x in b["temp"]), "temp: Ordner temp/ gefunden"),
        (any(x.endswith(".bak") for x in b["temp"]), "temp: .bak-Datei gefunden"),
        (os.path.join("docs", "de", "nur-de.md") in b["de_en_luecke"], "de_en_luecke: fehlendes en-Gegenstueck gefunden"),
        (not any("gut.md" in x for x in b["de_en_luecke"]), "de_en_luecke: vorhandenes Paar nicht gemeldet"),
        (any(h["name"] == "fs-alt-name" and h["datei"].endswith("start.md") for h in b["alte_namen"]), "alte_namen: Treffer in start.md"),
        (not any(h["datei"].endswith("erlaubt.md") for h in b["alte_namen"]), "alte_namen: --allow wirkt"),
        (res["status"] == "ok" and "branches_alt" in b and res["nicht_geprueft"][0] == NOT_RUN, "rahmen: status ok, nicht_geprueft nennt die ADR-Luecke"),
    ]
    bad_checks = [msg for ok, msg in checks if not ok]
    print(json.dumps({"selbsttest": "red" if bad_checks else "green", "fehlend": bad_checks,
                      "pruefungen": len(checks)}, ensure_ascii=False))
    return 1 if bad_checks else 0


def main(argv):
    if "--selbsttest" in argv:
        return selbsttest()
    ap = argparse.ArgumentParser(description="Read-only inventory of fs-documentation (see module docstring).")
    ap.add_argument("--docs", required=True)
    ap.add_argument("--repo")
    ap.add_argument("--retired")
    ap.add_argument("--now")
    ap.add_argument("--allow", action="append", default=[])
    ap.add_argument("--json")
    a = ap.parse_args(argv[1:])
    if not os.path.isdir(os.path.join(a.docs, "docs")):
        return bad(f"{a.docs}: kein docs/-Ordner, kein fs-documentation-Klon")
    retired = a.retired
    if retired is None and a.repo:
        retired = os.path.join(a.repo, "scripts", "retired-names.txt")
    if retired is not None and not os.path.isfile(retired):
        retired = None
    try:
        now = int(datetime.datetime.fromisoformat(a.now).replace(tzinfo=datetime.timezone.utc).timestamp()) if a.now \
            else int(datetime.datetime.now(datetime.timezone.utc).timestamp())
    except ValueError:
        return bad(f"--now {a.now!r}: kein Datum YYYY-MM-DD")
    res = inventory(a.docs, a.repo, retired, now, a.allow)
    text = json.dumps(res, ensure_ascii=False, indent=2)
    print(text)
    if a.json:
        with open(a.json, "w", encoding="utf-8") as f:
            f.write(text + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
