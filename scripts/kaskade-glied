#!/usr/bin/env python3
"""The current Glied of the pin cascade (call `kaskade-glied` of the workflow `pin-kaskade`, step `glied-start`). No network, writes nothing.

  python3 -I scripts/kaskade-glied --plan JSON|FILE|- --ausloeser vX.Y.Z [--dir <worktree of the Glied>]

Takes `plan.offen[0]`. `libs` = the trigger tag of fs-types plus the tags of the Glieder already done that this one depends on, as `NAME=vX.Y.Z` strings for the
lift (`fs-release lift --repo NAME=vX.Y.Z`; only the libraries the lift knows: fs-components, fs-interfaces, fs-types, fs-objects, fs-rpc, fs-jscalendar).
`tags` = the same for EVERY done Glied it depends on, as {repo: tag} (the step `rev-pins` needs fs-people, which the lift does not know). A dependency that is neither the trigger nor
done is red (the order was broken: no Glied is started before the ones it depends on). BUILD_PRIORITY of every build step of the Glied is 0 (`prioritaet`).
With `--dir` the tool file `.fs-lock-sources.toml` of the Glied worktree is ensured (format as in fs-objects and fs-components: `strict = true`, `only_from_enabled = true`): missing = created, an
existing `strict = false` / `only_from_enabled = false` is raised to true; `lock_datei` says `angelegt | gehoben | vorhanden` (a raise is also a `hinweise` entry, visible in the report). Only this file is written.
Result JSON: {status, red, lock_datei, hinweise, glied:{repo, art, tag, allow, besonderes, abhaengig, rev_pins, libs, tags, prioritaet}, befunde}. rc 0 / 1 red / 2 bad input.
"""
import argparse
import os
import re
import sys
import tomllib

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "kaskade_lib"))
import kio  # noqa: E402

LIFT_LIBS = ("fs-components", "fs-interfaces", "fs-types", "fs-objects", "fs-rpc", "fs-jscalendar")
TRIGGER_REPO = "fs-types"


WANT = {"strict": True, "only_from_enabled": True}


def ensure_lock_file(d, hinweise):
    """Creates `.fs-lock-sources.toml` (strict, only_from) or raises a false switch to true; returns angelegt | gehoben | vorhanden."""
    path = os.path.join(d, ".fs-lock-sources.toml")
    if not os.path.isdir(d):
        raise OSError(f"{d} is no folder")
    if not os.path.isfile(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write("# Lock check of this repo (scripts/check_lock_sources.py): one source per library, fs-types only from FreeSynergy/fs-types.\nstrict = true\nonly_from_enabled = true\n")
        hinweise.append(f"{path} created (strict = true, only_from_enabled = true)")
        return "angelegt"
    text = open(path, encoding="utf-8").read()
    have = tomllib.loads(text)
    new = text
    for k in WANT:
        if have.get(k) is True:
            continue
        pat = re.compile(rf"^{k}\s*=.*$", re.M)
        new = pat.sub(f"{k} = true", new) if pat.search(new) else new.rstrip("\n") + f"\n{k} = true\n"
        hinweise.append(f"{path}: {k} was {have.get(k)!r}, raised to true")
    if new == text:
        return "vorhanden"
    with open(path, "w", encoding="utf-8") as f:
        f.write(new)
    return "gehoben"


def main(argv):
    p = argparse.ArgumentParser()
    p.add_argument("--plan", required=True)
    p.add_argument("--ausloeser", required=True)
    p.add_argument("--dir")
    a = p.parse_args(argv)
    try:
        plan = kio.load_json(a.plan)
        offen = plan["offen"]
    except (ValueError, KeyError, TypeError) as e:
        return kio.skipped(f"plan: {e}")
    if not kio.TAG.match(a.ausloeser):
        return kio.skipped("ausloeser: must be vX.Y.Z")
    if not offen:
        return kio.skipped("plan.offen is empty: there is no Glied to start (the end check is next)")
    g = offen[0]
    done = {e["repo"]: e["tag"] for e in plan.get("erledigt", [])}
    tags, befunde = {TRIGGER_REPO: a.ausloeser}, []
    for dep in g.get("abhaengig", []):
        if dep == TRIGGER_REPO:
            continue
        if dep in done:
            tags[dep] = done[dep]
        else:
            befunde.append(f"{g['repo']} depends on {dep}, which is not done: the order is broken, nothing is started")
    libs = [f"{r}={t}" for r, t in sorted(tags.items()) if r in LIFT_LIBS]
    glied = {k: g.get(k) for k in ("repo", "art", "tag", "allow", "besonderes", "abhaengig", "rev_pins")}
    glied.update({"libs": libs, "tags": tags, "prioritaet": 0})
    lock, hinweise = None, []
    if a.dir:
        try:
            lock = ensure_lock_file(a.dir, hinweise)
        except (OSError, tomllib.TOMLDecodeError) as e:
            return kio.skipped(f"{a.dir}: {e}")
    kio.emit({"status": "ok", "red": bool(befunde), "lock_datei": lock, "hinweise": hinweise, "glied": glied, "befunde": befunde})
    return 1 if befunde else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
