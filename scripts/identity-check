#!/usr/bin/env bash
# Gate "identity" ([IDENTITAET], docs/usage.md "Identity check before ff"): author AND committer ADDRESS of EVERY commit of <base>..HEAD must be
# FS_ALLOWED_IDENTITY (default support@freesynergy.net). Names are NOT checked. Names the commit (short SHA), never the address. rc 0 green, 1 hit, 2 usage/git error.
#   scripts/identity-check [<repo root>] [<base>]   base default: $FS_IDENTITY_BASE, else origin/main
# CI case (CI or GITHUB_ACTIONS set and not false; GIT_DIR & co refused): the environment (FS_IDENTITY_BASE other than origin/main, FS_ALLOWED_IDENTITY other than the default) can NOT loosen the gate (a caller can set both through
# `test-env` into GITHUB_ENV): that is rc 1. Only fixture repos of the self tests may name another base, through the LOCAL repo config key freesynergy.identity-test-base
# (read with `git config --local`: no environment variable, not GIT_CONFIG_*, can set it); the 2nd argument comes from the calling script, not from the environment.
set -uo pipefail
root="${1:-.}"
default_id=support@freesynergy.net
# CI case: GITHUB_ACTIONS (protected in Actions) or CI (settable by a caller through test-env) set and not "false", any case
ci=0; for v in "${CI:-}" "${GITHUB_ACTIONS:-}"; do case "${v,,}" in ""|false|0) ;; *) ci=1 ;; esac; done
if [ "$ci" = 1 ]; then
  for v in GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_INDEX_FILE GIT_COMMON_DIR GIT_NAMESPACE; do
    if [ -n "${!v:-}" ]; then echo "identity FAILED: in CI $v must not be set (it would point git at another repo)" >&2; exit 1; fi
  done
  if { [ -n "${FS_IDENTITY_BASE:-}" ] && [ "$FS_IDENTITY_BASE" != origin/main ]; } || { [ -n "${FS_ALLOWED_IDENTITY:-}" ] && [ "$FS_ALLOWED_IDENTITY" != "$default_id" ]; }; then
    echo "identity FAILED: in CI (CI or GITHUB_ACTIONS set) FS_IDENTITY_BASE and FS_ALLOWED_IDENTITY from the environment must not loosen the gate (only origin/main and the fixed identity count)" >&2
    exit 1
  fi
  allowed="$default_id"
else
  allowed="${FS_ALLOWED_IDENTITY:-$default_id}"
fi
cd "$root" || exit 2
base="${2:-$(git config --local --get freesynergy.identity-test-base 2>/dev/null)}"
if [ -z "$base" ]; then
  if [ "$ci" = 1 ]; then base=origin/main; else base="${FS_IDENTITY_BASE:-origin/main}"; fi
fi
# --no-replace-objects: a local `git replace` must not show another commit than the real one
g() { git --no-replace-objects "$@"; }
g rev-parse --verify -q "$base^{commit}" >/dev/null || { echo "identity FAILED: base $base not found (fetch it, never skip)" >&2; exit 2; }
# Fields are separated by TAB (%x09), never by blank: an address with a blank must not shift the fields. A TAB or line break inside an address changes the line or field count: red as well.
hits="$(g log --format='%h%x09%ae%x09%ce' "$base..HEAD")" || exit 2
n="$(g rev-list --count "$base..HEAD")" || exit 2
bad="$(awk -F'\t' -v ok="$allowed" 'NF != 3 || $2 != ok || $3 != ok { print $1 }' <<<"$hits")"
[ "$(grep -c . <<<"$hits")" -eq "$n" ] || bad="$bad count-mismatch"
if [ -n "$bad" ]; then
  echo "identity FAILED: commits with author or committer other than FS_ALLOWED_IDENTITY: $(tr '\n' ' ' <<<"$bad")" >&2
  echo "rewrite the branch as a NEW branch -rN with an equal tree (workflow branch-neu-schreiben), never main or a public tag" >&2
  exit 1
fi
echo "identity ok: $(grep -c . <<<"$hits") commit(s) in $base..HEAD, author and committer = FS_ALLOWED_IDENTITY"
