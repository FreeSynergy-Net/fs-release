# Fields are separated by TAB (%x09), never by blank: an address with a blank, a TAB or a line break must not shift the fields (such an address is never equal to FS_ALLOWED_IDENTITY).
# A TAB or line break in an address makes the line count differ from the commit count: then it is red as well (the commit count is taken from rev-list).
# Fields are separated by TAB (%x09), never by blank: an address with a blank must not shift the fields. A TAB or line break inside an address changes the line or field count: red as well.
hits="$(git log --format='%h%x09%ae%x09%ce' "$base..HEAD")" || exit 2
n="$(git rev-list --count "$base..HEAD")" || exit 2
