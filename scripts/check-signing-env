#!/usr/bin/env python3
"""Structure check: the signing job has a GitHub ENVIRONMENT (required reviewer = the owner) and only it touches the signing secrets.

  python3 -I scripts/check-signing-env [<workflow file or folder>...]     (default: .github/workflows and examples, relative to the repo root)

For every job of every workflow file (also the mirror / site templates of other repos, pass them as arguments):
  1. a job with a step `uses: .../actions/sign-files@...` or a `run:` of `scripts/site-signieren.sh` (the signer) must have `environment:`;
  2. a job that mentions `GPG_` (secrets `GPG_PRIVATE_KEY`, `GPG_PASSPHRASE`) must be a signer or a call of the reusable `release.yml` / `_release-finalize.yml` of fs-release
     (a job with `uses:` cannot have an `environment:` itself; the environment sits in the called job);
rc 0 = ok, rc 1 = red (one line `file: job: reason`), rc 2 = bad input or no PyYAML (nothing was checked, never green).
"""
import os
import sys

try:
    import yaml
except ImportError:
    print("skipped: no PyYAML, nothing was checked")
    sys.exit(2)


def workflow_files(paths):
    for p in paths:
        if os.path.isfile(p):
            yield p
            continue
        for base, _, names in os.walk(p):
            for n in sorted(names):
                if n.endswith((".yml", ".yaml")):
                    yield os.path.join(base, n)


def check(path):
    try:
        with open(path, encoding="utf-8") as f:
            doc = yaml.safe_load(f)
    except (OSError, yaml.YAMLError) as e:
        return [f"{path}: cannot be read ({e})"]
    jobs = doc.get("jobs") if isinstance(doc, dict) else None
    if not isinstance(jobs, dict):
        return []
    problems = []
    for name, job in jobs.items():
        if not isinstance(job, dict):
            continue
        text = yaml.dump(job)
        steps = job.get("steps") or []
        # signer = a step `uses: .../actions/sign-files@` or a step that runs the site signing script (scripts/site-signieren.sh)
        signer = any(isinstance(s, dict) and ("/actions/sign-files@" in str(s.get("uses", "")) or "scripts/site-signieren.sh" in str(s.get("run", ""))) for s in steps)
        # a job with `uses:` cannot have an `environment:`; it only hands the secrets to the reusable workflow whose signing job has one
        calls_final = any(f"fs-release/.github/workflows/{w}.yml@" in str(job.get("uses", "")) for w in ("release", "_release-finalize")) or str(job.get("uses", "")).startswith("./.github/workflows/_release-finalize.yml")
        if signer and not job.get("environment"):
            problems.append(f"{path}: {name}: the signing job has no `environment:` (required reviewer = the owner)")
        if "GPG_" in text and not (signer or calls_final):
            problems.append(f"{path}: {name}: touches the signing secrets but is not the signing job")
    return problems


def main(argv):
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    paths = argv or [os.path.join(root, d) for d in (".github/workflows", "examples") if os.path.exists(os.path.join(root, d))]
    for p in paths:
        if not os.path.exists(p):
            print(f"bad input: {p} does not exist")
            return 2
    red = [pr for f in sorted(set(workflow_files(paths))) for pr in check(f)]
    for r in red:
        print(f"red: {r}")
    if red:
        return 1
    print("ok: every signing job has an environment, no other job touches the signing secrets")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
