#!/usr/bin/env python3
"""Gate doku-mitziehen: a change of code, names, interfaces or behaviour pulls the documentation along in the same run.

  python3 -I scripts/doku-mitziehen --docs <fs-documentation clone> --docs-base <sha> [--code <repo> --code-base <sha>]
        [--program NAME] [--old NAME]... [--new NAME]... [--allow GLOB]... [--state FILE] [--json FILE]

Deterministic, no network, no AI. Checks (every problem is one line `red: <reason>`):
  1. changed         the code repo changed since --code-base, so the docs clone must have changed since --docs-base
                     (files under docs/, conventions/, mkdocs.yml, README.md); no docs change = red.
  2. de-en           a changed docs/de/<x> needs a changed docs/en/<x> and the other way round (official docs in both languages).
  3. old-names       every --old name (the former name of a repo, crate or interface) must not appear anywhere in the docs
                     (docs/, conventions/, mkdocs.yml, README.md), except in files matching --allow (history, ADR text).
  4. new-names       every --new name must appear in the docs at least once.
  5. links           every relative Markdown link in docs/ points to an existing file (anchors are not followed).
  6. checklist       the code repo changed, so the checklist of the program (docs clone: todo/checklisten/<program>.md, `--program`,
                     default = folder name of --code) must have changed too; it must exist, every `- [x]` line needs a proof in
                     parentheses, and no `- [x]` line may disappear (done items stay). A change of the program without its checklist = red.
  7. mkdocs          `mkdocs build --strict` of the clone; when mkdocs is missing or broken the result is `skipped`, never green.
The docs clone is only read (the mkdocs build goes to a temporary folder). NOTE: `mkdocs build` runs the hooks and plugins named in
the mkdocs.yml of the clone, i.e. code of the author's branch; use it only on the own docs repo.
Round counter: the state file (default `<git dir of the docs clone>/doku-mitziehen-runde`, found with `git rev-parse --absolute-git-dir`,
so it also works in a git worktree where `.git` is a file; never tracked; outside git a file in the temp folder) counts red rounds
(+1 on red, reset on green); the output has `runde=N`.
rc 0 = green; rc 1 = red (round 1 or 2); rc 2 = bad input or mkdocs skipped (never green, counter untouched); rc 3 = red in the
third round or later (escalate to the person). `--json FILE` writes {"status": "green"|"red"|"skipped", "red": bool, "runde": N,
"problems": [...], "skipped": [...]} - also for rc 2 (status "skipped", never "green"; for bad input status "skipped" with the line in problems).
"""
import argparse
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

DOC_ROOTS = ("docs", "conventions", "mkdocs.yml", "README.md")
LINK = re.compile(r"(?<!\!)\[[^\]]*\]\(([^)\s#][^)\s]*?)(?:#[^)\s]*)?(?:\s+\"[^\"]*\")?\)")


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if r.returncode != 0:
        raise ValueError(f"git {' '.join(args)} in {repo}: {r.stderr.strip()}")
    return r.stdout


def changed(repo, base, paths=None):
    args = ["diff", "--name-only", f"{base}..HEAD"]
    if paths:
        args += ["--", *paths]
    out = git(repo, *args).split("\n")
    # committed changes plus uncommitted ones of the working tree (the run commits last)
    out += git(repo, "diff", "--name-only", "HEAD", *(["--", *paths] if paths else [])).split("\n")
    out += git(repo, "ls-files", "--others", "--exclude-standard", *(["--", *paths] if paths else [])).split("\n")
    return sorted({p for p in out if p})


def doc_files(docs):
    for root in DOC_ROOTS:
        path = os.path.join(docs, root)
        if os.path.isfile(path):
            yield root
        for base, _, names in os.walk(path):
            for n in names:
                if n.endswith((".md", ".yml", ".yaml")):
                    yield os.path.relpath(os.path.join(base, n), docs)


def allowed(rel, allow):
    return any(fnmatch.fnmatch(rel, g) for g in allow)


def check_changed(a, problems):
    if not a.code:
        return
    code = changed(a.code, a.code_base)
    docs = changed(a.docs, a.docs_base, list(DOC_ROOTS))
    if code and not docs:
        problems.append(f"red: the code repo changed ({len(code)} file(s)) but the documentation did not - pull the docs along")


CHECKBOX = re.compile(r"^\s*- \[( |x)\] ")
PROOF = re.compile(r"\([^()]*\S[^()]*\)")


def check_checklist(a, problems):
    """The checklist of the program moves with the program (todo/checklisten/<program>.md of the docs clone)."""
    if not a.code:
        return
    if not changed(a.code, a.code_base):
        return
    program = a.program or os.path.basename(os.path.realpath(a.code))
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", program):
        raise ValueError(f"bad --program {program!r}")
    rel = f"todo/checklisten/{program}.md"
    path = os.path.join(a.docs, rel)
    if not os.path.isfile(path):
        problems.append(f"red: the program {program} changed but its checklist {rel} does not exist")
        return
    if rel not in changed(a.docs, a.docs_base, [rel]):
        problems.append(f"red: the program {program} changed but its checklist {rel} was not updated (tick, add or note the change)")
    boxes = 0
    for n, line in enumerate(open(path, encoding="utf-8", errors="replace"), 1):
        if CHECKBOX.match(line):
            boxes += 1
            if line.lstrip().startswith("- [x]") and not PROOF.search(line):
                problems.append(f"red: {rel}:{n} is ticked without a proof in parentheses (commit, tag or picture)")
    if boxes == 0:
        problems.append(f"red: {rel} has no `- [ ]` / `- [x]` item")
    diff = git(a.docs, "diff", a.docs_base, "--", rel).split("\n")
    for line in diff:
        if line.startswith("-") and not line.startswith("---") and line[1:].lstrip().startswith("- [x]"):
            problems.append(f"red: {rel}: a ticked item was removed or reworded ({line[1:].strip()[:60]}); done items stay")


def check_de_en(a, problems):
    files = changed(a.docs, a.docs_base, ["docs/de", "docs/en"])
    have = set(files)
    for f in files:
        if not f.endswith(".md"):
            continue
        other = f.replace("docs/de/", "docs/en/", 1) if f.startswith("docs/de/") else f.replace("docs/en/", "docs/de/", 1)
        if other not in have:
            problems.append(f"red: {f} changed, {other} did not (docs in German and English together)")


def check_names(a, problems):
    texts = {}
    for rel in doc_files(a.docs):
        if not allowed(rel, a.allow):
            texts[rel] = open(os.path.join(a.docs, rel), encoding="utf-8", errors="replace").read()
    for old in a.old:
        pat = re.compile(r"(?<![\w-])" + re.escape(old) + r"(?![\w-])")
        for rel, text in texts.items():
            for n, line in enumerate(text.split("\n"), 1):
                if pat.search(line):
                    problems.append(f"red: old name {old!r} still in {rel}:{n}")
    for new in a.new:
        pat = re.compile(r"(?<![\w-])" + re.escape(new) + r"(?![\w-])")
        if not any(pat.search(t) for t in texts.values()):
            problems.append(f"red: new name {new!r} appears nowhere in the docs")


def check_links(a, problems):
    for rel in doc_files(a.docs):
        if not rel.endswith(".md"):
            continue
        base = os.path.dirname(os.path.join(a.docs, rel))
        in_code = False
        for n, line in enumerate(open(os.path.join(a.docs, rel), encoding="utf-8", errors="replace"), 1):
            if line.lstrip().startswith("```"):
                in_code = not in_code
            if in_code:
                continue
            for target in LINK.findall(line):
                if re.match(r"[a-z][a-z0-9+.-]*:", target) or target.startswith("/"):
                    continue
                if not os.path.exists(os.path.normpath(os.path.join(base, target))):
                    problems.append(f"red: broken link {target!r} in {rel}:{n}")


def check_mkdocs(a, problems, skipped):
    probe = subprocess.run(["mkdocs", "--version"], capture_output=True, text=True) if shutil.which("mkdocs") else None
    if probe is None or probe.returncode != 0:
        skipped.append("mkdocs: not installed or broken, `mkdocs build --strict` was NOT run")
        return
    with tempfile.TemporaryDirectory() as out:
        r = subprocess.run(
            ["mkdocs", "build", "--strict", "-q", "-f", os.path.join(a.docs, "mkdocs.yml"), "-d", out],
            capture_output=True,
            text=True,
        )
    if r.returncode != 0:
        tail = " | ".join((r.stdout + r.stderr).strip().split("\n")[-3:])
        problems.append(f"red: mkdocs build --strict failed: {tail}")


def state_path(a):
    try:
        gitdir = git(a.docs, "rev-parse", "--absolute-git-dir").strip()
    except ValueError:
        gitdir = private_state_dir()
    return a.state or os.path.join(gitdir, "doku-mitziehen-runde")


def write_json(a, status, red, runde, problems, skipped):
    if a.json:
        with open(a.json, "w") as f:
            json.dump({"status": status, "red": red, "runde": runde, "problems": problems, "skipped": skipped}, f)


def private_state_dir():
    """A per-user folder (mode 0700) for state files, never the shared /tmp with a predictable name."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    d = os.path.join(base, "freesynergy")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def counter(path, red):
    """Round counter in a state file; it never follows a symlink (O_NOFOLLOW), a refused file raises OSError."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as f:
            n = int(f.read().strip() or 0)
    except FileNotFoundError:
        n = 0
    except ValueError:
        n = 0
    n = n + 1 if red else 0
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(f"{n}\n")
    return n


def main(argv):
    p = argparse.ArgumentParser(add_help=True)
    p.add_argument("--docs", required=True)
    p.add_argument("--docs-base", required=True)
    p.add_argument("--code")
    p.add_argument("--code-base")
    p.add_argument("--program")
    p.add_argument("--old", action="append", default=[])
    p.add_argument("--new", action="append", default=[])
    p.add_argument("--allow", action="append", default=[])
    p.add_argument("--state")
    p.add_argument("--json")
    try:
        a = p.parse_args(argv)
    except SystemExit:
        return 2
    if bool(a.code) != bool(a.code_base):
        print("bad input: --code and --code-base belong together")
        write_json(a, "skipped", False, 0, ["bad input: --code and --code-base belong together"], [])
        return 2
    problems, skipped = [], []
    try:
        for check in (check_changed, check_checklist, check_de_en, check_names, check_links):
            check(a, problems)
        check_mkdocs(a, problems, skipped)
    except (ValueError, OSError) as e:
        print(f"bad input: {e}")
        write_json(a, "skipped", False, 0, [f"bad input: {e}"], [])
        return 2
    for s in skipped:
        print(f"skipped: {s}")
    for line in problems:
        print(line)
    red = bool(problems)
    if skipped and not red:
        print("skipped: not green because a check did not run")
        write_json(a, "skipped", False, 0, problems, skipped)
        return 2
    try:
        runde = counter(state_path(a), red)
    except OSError as e:
        print(f"skipped: the state file cannot be used ({e}); never green without a counter")
        write_json(a, "skipped", False, 0, problems, [f"state file: {e}"])
        return 2
    print(f"runde={runde}")
    write_json(a, "red" if red else "green", red, runde, problems, skipped)
    if not red:
        print("green: the documentation moved with the change")
        return 0
    return 3 if runde >= 3 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
