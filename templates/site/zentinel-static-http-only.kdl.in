// Zentinel static-files for three sites: FIRST-START variant, plain HTTP only, no TLS and no ACME (render.sh --http-only). Zentinel stops at start
// when the first certificate cannot be issued, so the first start uses this file; switch to the staging rendering when the DNS records point to
// this server and port 80 is reachable. Same routes, document roots (`<webroot>/<domain>/current`) and headers as zentinel-static.kdl.in.
schema-version "1.0"

system {
    worker-threads 0
    graceful-shutdown-timeout-secs 30
}

listeners {
    listener "http" {
        address "@HTTP_ADDR@"
        protocol "http"
        request-timeout-secs 30
    }
}

routes {
@ROUTES@
}

limits {
    max-header-size 8192
    max-header-count 100
    max-body-size 1048576
}

observability {
    logging {
        level "info"
        format "json"
    }
}
