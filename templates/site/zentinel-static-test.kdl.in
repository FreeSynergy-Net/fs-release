// Zentinel static-files for three sites: LOCAL TEST variant (no TLS, no ACME, no network). Same redirect namespace, routes, document roots and
// headers as zentinel-static.kdl.in; port 80 and 443 are replaced by test-port addresses. Rendered by render.sh --test.
schema-version "1.0"

system {
    worker-threads 1
}

listeners {
    listener "http" {
        address "@HTTP_ADDR@"
        protocol "http"
        request-timeout-secs 30
        namespace "redirect"
    }
    listener "sites" {
        address "@HTTPS_ADDR@"
        protocol "http"
        request-timeout-secs 30
    }
}

// A listener that belongs to a namespace serves only that namespace's routes (upstream: crates/config/src/scopes.rs). Port 80 therefore answers
// every request with a real 301 to https (same host and path; the query string is NOT carried over). Measured with 26.11_2 (messung-zentinel-redirect.md,
// messung-zentinel-stufe1.md, test-podman.sh): GET, HEAD, POST, PUT all give 301 (no 307/308), IPv6 [::1] the same, unknown hosts get a 301 too; the ACME
// HTTP-01 challenge on this listener is answered BEFORE the redirect (Pebble, 3 of 3; an unknown token gets the 301); the log shows a harmless ERROR
// "ACME challenge served, status: 500" next to the answer 200. Not measured against the real Let's Encrypt: the staging run is that proof.
namespace "redirect" {
    filters {
        filter "to-https" {
            type "redirect"
            scheme "https"
            status-code 301
        }
    }
    routes {
        route "to-https" {
            matches {
                path-prefix "/"
            }
            service-type "web"
            filters "to-https"
        }
    }
}

routes {
@ROUTES@
}

limits {
    max-header-size 8192
    max-header-count 100
    max-body-size 1048576
}

observability {
    logging {
        level "info"
        format "json"
    }
}
