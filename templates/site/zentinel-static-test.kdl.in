// Zentinel static-files for three sites: LOCAL TEST variant (no TLS, no ACME, no network). Same redirect namespace, routes, document roots and
// headers as zentinel-static.kdl.in; port 80 and 443 are replaced by test-port addresses. Rendered by render.sh --test.
schema-version "1.0"

system {
    worker-threads 1
}

listeners {
    listener "http" {
        address "@HTTP_ADDR@"
        protocol "http"
        request-timeout-secs 30
        namespace "redirect"
    }
    listener "sites" {
        address "@HTTPS_ADDR@"
        protocol "http"
        request-timeout-secs 30
    }
}

// A listener that belongs to a namespace serves only that namespace's routes (upstream: crates/config/src/scopes.rs). Port 80 therefore answers
// every request with a real 301 to https (same host and path; the query string is NOT carried over). Measured with 26.11_2 on a high port (GET):
// messung-zentinel-redirect.md and fs-zentinel examples/test_serve.sh. NOT measured: ACME HTTP-01 on this listener (upstream answers the challenge
// before the routing, acme.md / http_trait.rs), HEAD, POST, IPv6. The staging run checks these; until then they are "not proven".
namespace "redirect" {
    filters {
        filter "to-https" {
            type "redirect"
            scheme "https"
            status-code 301
        }
    }
    routes {
        route "to-https" {
            matches {
                path-prefix "/"
            }
            service-type "web"
            filters "to-https"
        }
    }
}

routes {
    route "site1" {
        matches {
            host "@SITE1@"
            path-prefix "/"
        }
        service-type "static"
        static-files {
            // the folder `current` is a link to releases/<version>, swapped atomically by the person (site-signieren, step deliver)
            root "@WEBROOT@/@SITE1@/current"
            index "index.html"
            cache-control "public, max-age=300"
            compress #true
        }
        policies {
            response-headers {
                set {
                    "Content-Security-Policy" "@CSP1@"
                    "X-Content-Type-Options" "nosniff"
                    "Referrer-Policy" "no-referrer"
                }
            }
        }
    }
    route "site2" {
        matches {
            host "@SITE2@"
            path-prefix "/"
        }
        service-type "static"
        static-files {
            // the folder `current` is a link to releases/<version>, swapped atomically by the person (site-signieren, step deliver)
            root "@WEBROOT@/@SITE2@/current"
            index "index.html"
            cache-control "public, max-age=300"
            compress #true
        }
        policies {
            response-headers {
                set {
                    "Content-Security-Policy" "@CSP2@"
                    "X-Content-Type-Options" "nosniff"
                    "Referrer-Policy" "no-referrer"
                }
            }
        }
    }
    route "site3" {
        matches {
            host "@SITE3@"
            path-prefix "/"
        }
        service-type "static"
        static-files {
            // the folder `current` is a link to releases/<version>, swapped atomically by the person (site-signieren, step deliver)
            root "@WEBROOT@/@SITE3@/current"
            index "index.html"
            cache-control "public, max-age=300"
            compress #true
        }
        policies {
            response-headers {
                set {
                    "Content-Security-Policy" "@CSP3@"
                    "X-Content-Type-Options" "nosniff"
                    "Referrer-Policy" "no-referrer"
                }
            }
        }
    }
}

limits {
    max-header-size 8192
    max-header-count 100
    max-body-size 1048576
}

observability {
    logging {
        level "info"
        format "json"
    }
}
