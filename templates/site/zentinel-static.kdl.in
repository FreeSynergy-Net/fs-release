// Zentinel static-files for three sites (stage 0 of the website): HTTPS with ACME HTTP-01 (Let's Encrypt), one document root per domain.
// TEMPLATE. Render it with render.sh; the upper-case markers between two @ signs are replaced, nothing else. No secrets are needed or stored here.
// Port 80 redirects with a real 301 (namespace "redirect" below, see the comment there). Document roots are `<webroot>/<domain>/current`.
// The first certificates are fetched at start through a temporary challenge server on the first http listener; renewals are answered by
// the running proxy. A FIRST start with ACME in the configuration stops when the first certificate cannot be issued (fs-zentinel examples/README.md):
// start with `render.sh --http-only` first, DNS set and port 80 reachable, then staging (ACME_STAGING=true, certificates untrusted by browsers),
// and only then production.
// Content-Security-Policy per site is a SETTING of its site.toml (csp.mode / csp.policy), the default is strict (no script, nothing from outside).
// HONEST NOTE: Zentinel 26.11_2 does NOT send these response-headers (CSP, nosniff, referrer) on static-files routes (measured). They are written for the version that does.
// Until then the wall for mode static is the folder check (page-own <meta> CSP, allowlist); a passthrough site is refused by render.py unless --allow-passthrough.
// The host names come ONLY from the site.toml files (render.py); nothing is written into this template.
schema-version "1.0"

system {
    worker-threads 0
    graceful-shutdown-timeout-secs 30
}

listeners {
    listener "http" {
        address "@HTTP_ADDR@"
        protocol "http"
        request-timeout-secs 30
        namespace "redirect"
    }

    listener "https" {
        address "@HTTPS_ADDR@"
        protocol "https"
        request-timeout-secs 30
        tls {
            min-version "TLS1.2"

            // One certificate per site (primary name plus aliases); a domain may appear in only one acme block (upstream rule).
@ACME@
        }
    }
}

// A listener that belongs to a namespace serves only that namespace's routes (upstream: crates/config/src/scopes.rs). Port 80 therefore answers
// every request with a real 301 to https (same host and path; the query string is NOT carried over). Measured with 26.11_2 (messung-zentinel-redirect.md,
// messung-zentinel-stufe1.md, test-podman.sh): GET, HEAD, POST, PUT all give 301 (no 307/308), IPv6 [::1] the same, unknown hosts get a 301 too; the ACME
// HTTP-01 challenge on this listener is answered BEFORE the redirect (Pebble, 3 of 3; an unknown token gets the 301); the log shows a harmless ERROR
// "ACME challenge served, status: 500" next to the answer 200. Not measured against the real Let's Encrypt: the staging run is that proof.
namespace "redirect" {
    filters {
        filter "to-https" {
            type "redirect"
            scheme "https"
            status-code 301
        }
    }
    routes {
        route "to-https" {
            matches {
                path-prefix "/"
            }
            service-type "web"
            filters "to-https"
        }
    }
}

routes {
@ROUTES@
}

limits {
    max-header-size 8192
    max-header-count 100
    max-body-size 1048576
}

observability {
    logging {
        level "info"
        format "json"
    }
}
