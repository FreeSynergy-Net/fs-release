// Zentinel static-files for three sites (stage 0 of the website): HTTPS with ACME HTTP-01 (Let's Encrypt), one document root per domain.
// TEMPLATE. Render it with render.sh; the upper-case markers between two @ signs are replaced, nothing else. No secrets are needed or stored here.
// Port 80 redirects with a real 301 (namespace "redirect" below, see the comment there). Document roots are `<webroot>/<domain>/current`.
// The first certificates are fetched at start through a temporary challenge server on the first http listener; renewals are answered by
// the running proxy. A FIRST start with ACME in the configuration stops when the first certificate cannot be issued (fs-zentinel examples/README.md):
// start with `render.sh --http-only` first, DNS set and port 80 reachable, then staging (ACME_STAGING=true, certificates untrusted by browsers),
// and only then production.
// Content-Security-Policy per site is a SETTING (render.sh CSP_MODE1..3 / CSP1..3), the default is strict (no script, nothing from outside).
schema-version "1.0"

system {
    worker-threads 0
    graceful-shutdown-timeout-secs 30
}

listeners {
    listener "http" {
        address "@HTTP_ADDR@"
        protocol "http"
        request-timeout-secs 30
        namespace "redirect"
    }

    listener "https" {
        address "@HTTPS_ADDR@"
        protocol "https"
        request-timeout-secs 30
        tls {
            min-version "TLS1.2"

            // One certificate per domain; a domain may appear in only one acme block (upstream rule).
            acme {
                email "@ACME_EMAIL@"
                domains "@SITE1@"
                staging #@ACME_STAGING@
                storage "/var/lib/zentinel/acme"
                challenge-type "http-01"
            }
            sni {
                acme {
                    email "@ACME_EMAIL@"
                    domains "@SITE2@"
                    staging #@ACME_STAGING@
                    storage "/var/lib/zentinel/acme"
                    challenge-type "http-01"
                }
            }
            sni {
                acme {
                    email "@ACME_EMAIL@"
                    domains "@SITE3@"
                    staging #@ACME_STAGING@
                    storage "/var/lib/zentinel/acme"
                    challenge-type "http-01"
                }
            }
        }
    }
}

// A listener that belongs to a namespace serves only that namespace's routes (upstream: crates/config/src/scopes.rs). Port 80 therefore answers
// every request with a real 301 to https (same host and path; the query string is NOT carried over). Measured with 26.11_2 on a high port (GET):
// messung-zentinel-redirect.md and fs-zentinel examples/test_serve.sh. NOT measured: ACME HTTP-01 on this listener (upstream answers the challenge
// before the routing, acme.md / http_trait.rs), HEAD, POST, IPv6. The staging run checks these; until then they are "not proven".
namespace "redirect" {
    filters {
        filter "to-https" {
            type "redirect"
            scheme "https"
            status-code 301
        }
    }
    routes {
        route "to-https" {
            matches {
                path-prefix "/"
            }
            service-type "web"
            filters "to-https"
        }
    }
}

routes {
    route "site1" {
        matches {
            host "@SITE1@"
            path-prefix "/"
        }
        service-type "static"
        static-files {
            // the folder `current` is a link to releases/<version>, swapped atomically by the person (site-signieren, step deliver)
            root "@WEBROOT@/@SITE1@/current"
            index "index.html"
            cache-control "public, max-age=300"
            compress #true
        }
        policies {
            response-headers {
                set {
                    "Content-Security-Policy" "@CSP1@"
                    "X-Content-Type-Options" "nosniff"
                    "Referrer-Policy" "no-referrer"
                }
            }
        }
    }
    route "site2" {
        matches {
            host "@SITE2@"
            path-prefix "/"
        }
        service-type "static"
        static-files {
            // the folder `current` is a link to releases/<version>, swapped atomically by the person (site-signieren, step deliver)
            root "@WEBROOT@/@SITE2@/current"
            index "index.html"
            cache-control "public, max-age=300"
            compress #true
        }
        policies {
            response-headers {
                set {
                    "Content-Security-Policy" "@CSP2@"
                    "X-Content-Type-Options" "nosniff"
                    "Referrer-Policy" "no-referrer"
                }
            }
        }
    }
    route "site3" {
        matches {
            host "@SITE3@"
            path-prefix "/"
        }
        service-type "static"
        static-files {
            // the folder `current` is a link to releases/<version>, swapped atomically by the person (site-signieren, step deliver)
            root "@WEBROOT@/@SITE3@/current"
            index "index.html"
            cache-control "public, max-age=300"
            compress #true
        }
        policies {
            response-headers {
                set {
                    "Content-Security-Policy" "@CSP3@"
                    "X-Content-Type-Options" "nosniff"
                    "Referrer-Policy" "no-referrer"
                }
            }
        }
    }
}

limits {
    max-header-size 8192
    max-header-count 100
    max-body-size 1048576
}

observability {
    logging {
        level "info"
        format "json"
    }
}
