# generated by fs-blueprint 0.0.16 from scaffold.toml sha256 50b64d3977a38bcf0b3d2ff8a4ba27a141b630b4cd7c8b8cd99e39a04e0b9905; content sha256 fe3537dafc50043f57fccd54addcd563be53b1fac150f43784b6036f8216d0a8; do not edit by hand
name: check
on:
  push:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: "${{ github.workflow }}-${{ github.ref }}"
  cancel-in-progress: true

# A data package has no Cargo.toml: the gates of the code (fmt, clippy, test) would go red on it, so there the blueprint check (`--drift`) is the CI.
# A repo that has a Cargo.toml keeps the gates of fs-release.
jobs:
  kind:
    runs-on: ubuntu-latest
    outputs:
      code: ${{ steps.look.outputs.code }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - id: look
        run: if [ -f Cargo.toml ]; then echo "code=true" >> "$GITHUB_OUTPUT"; else echo "code=false" >> "$GITHUB_OUTPUT"; fi
  package:
    needs: kind
    if: needs.kind.outputs.code != 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: FreeSynergy/fs-documentation
          path: .fs-documentation
          persist-credentials: false
      - run: cargo install --git https://github.com/FreeSynergy/fs-release --tag v0.0.16 --locked --root "$RUNNER_TEMP/fsbp" fs-blueprint
      - run: '"$RUNNER_TEMP/fsbp/bin/fs-blueprint" check --repo "$PWD" --talks "$PWD/.fs-documentation" --drift'
  code:
    needs: kind
    if: needs.kind.outputs.code == 'true'
    uses: FreeSynergy/fs-release/.github/workflows/check.yml@v0.0.16
    with:
      blueprint: warn
