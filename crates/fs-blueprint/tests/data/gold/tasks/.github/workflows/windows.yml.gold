# generated by fs-blueprint 0.0.13 from scaffold.toml sha256 167a6276086b90300ab857249fa1a2381991e2a6ab23b8115f9e4dcea298f0f4; content sha256 5eb192e0c9f3b9c51af45a07633df65dc397231a4d7271e6865d9dfd6d4c54d3; do not edit by hand
name: windows
on:
  push:
  workflow_dispatch:
    inputs:
      cache: { type: boolean, default: true, description: "Rust cache on; false = cold run" }

permissions:
  contents: read

# A data package has no Cargo.toml: `cargo fmt --check` of the Windows gate would go red on it, so there the blueprint check (`--drift`) runs on Windows.
jobs:
  kind:
    runs-on: ubuntu-latest
    outputs:
      code: ${{ steps.look.outputs.code }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - id: look
        run: if [ -f Cargo.toml ]; then echo "code=true" >> "$GITHUB_OUTPUT"; else echo "code=false" >> "$GITHUB_OUTPUT"; fi
  package:
    needs: kind
    if: needs.kind.outputs.code != 'true'
    runs-on: windows-latest
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: FreeSynergy/fs-documentation
          path: .fs-documentation
          persist-credentials: false
      - run: cargo install --git https://github.com/FreeSynergy/fs-release --tag v0.0.13 --locked --root "$RUNNER_TEMP/fsbp" fs-blueprint
      - run: '"$RUNNER_TEMP/fsbp/bin/fs-blueprint" check --repo "$PWD" --talks "$PWD/.fs-documentation" --drift'
  windows:
    needs: kind
    if: needs.kind.outputs.code == 'true'
    uses: FreeSynergy/fs-release/.github/workflows/_windows-check.yml@v0.0.13
    with:
      cache: ${{ github.event_name != 'workflow_dispatch' || inputs.cache }}
