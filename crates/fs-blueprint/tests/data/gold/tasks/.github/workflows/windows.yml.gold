# generated by fs-blueprint 0.0.17 from scaffold.toml sha256 50b64d3977a38bcf0b3d2ff8a4ba27a141b630b4cd7c8b8cd99e39a04e0b9905; content sha256 f05f569663b42f22d3a021d28daee8362c15a8f38e37b3a7993fa48e65017541; do not edit by hand
name: windows
on:
  push:
  workflow_dispatch:
    inputs:
      cache: { type: boolean, default: true, description: "Rust cache on; false = cold run" }

permissions:
  contents: read

# A data package has no Cargo.toml: `cargo fmt --check` of the Windows gate would go red on it, so there the blueprint check (`--drift`) runs on Windows.
jobs:
  kind:
    runs-on: ubuntu-latest
    outputs:
      code: ${{ steps.look.outputs.code }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - id: look
        run: if [ -f Cargo.toml ]; then echo "code=true" >> "$GITHUB_OUTPUT"; else echo "code=false" >> "$GITHUB_OUTPUT"; fi
  package:
    needs: kind
    if: needs.kind.outputs.code != 'true'
    runs-on: windows-latest
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: FreeSynergy-Net/fs-documentation
          path: .fs-documentation
          persist-credentials: false
      - run: cargo install --git https://github.com/FreeSynergy-Net/fs-release --tag v0.0.17 --locked --root "$RUNNER_TEMP/fsbp" fs-blueprint
      - run: '"$RUNNER_TEMP/fsbp/bin/fs-blueprint" check --repo "$PWD" --talks "$PWD/.fs-documentation" --drift'
  windows:
    needs: kind
    if: needs.kind.outputs.code == 'true'
    uses: FreeSynergy-Net/fs-release/.github/workflows/_windows-check.yml@v0.0.17
    with:
      cache: ${{ github.event_name != 'workflow_dispatch' || inputs.cache }}
