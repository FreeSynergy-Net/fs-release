//! `fs-tasks-client`: the program as a client of its own server: the socket, the handshake, the stop.
//!
//! Pattern: Facade: names and a few functions over `fs-rpc`, each with its own runtime so no caller needs one.
#![deny(missing_docs)]
#![warn(clippy::pedantic)]

use std::fmt;
use std::path::{Path, PathBuf};

use fs_rpc::{Expected, connect_matching};
pub use fs_rpc::{CommandStarter, ServerStarter};

/// The program name of the server, as `Control.version` says it.
pub const PROGRAM: &str = "fs-tasks";

/// The name the socket is made from (the server says the same).
const SOCKET_PROGRAM: &str = "tasks";

/// Why no usable server was reached.
#[derive(Debug)]
pub struct Error(String);

impl fmt::Display for Error {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "no fitting server: {}", self.0)
    }
}

impl std::error::Error for Error {}

/// Where the server listens when nobody says otherwise, the same place `serve` binds.
#[must_use]
pub fn default_socket() -> Option<PathBuf> {
    fs_rpc::default_socket(SOCKET_PROGRAM)
}

fn runtime() -> Result<tokio::runtime::Runtime, Error> {
    tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()
        .map_err(|e| Error(e.to_string()))
}

/// Connect to the server on `socket` (the `starter` starts or replaces it when needed) and check that it is this program in this version.
///
/// # Errors
/// [`Error`] when no fitting server could be reached.
pub fn handshake(socket: &Path, starter: &dyn ServerStarter) -> Result<(), Error> {
    let runtime = runtime()?;
    let local = tokio::task::LocalSet::new();
    local.block_on(&runtime, async {
        let wanted = Expected::new(env!("CARGO_PKG_VERSION")).with_program(PROGRAM);
        connect_matching::<capnp::capability::Client>(socket, &wanted, starter)
            .await
            .map(|_| ())
            .map_err(|e| Error(e.to_string()))
    })
}

/// Ask the server on `socket` to end in order (`Control.stop`).
///
/// # Errors
/// [`Error`] when nothing listens there, the server runs as another user, or it refused.
pub fn stop(socket: &Path) -> Result<(), Error> {
    let runtime = runtime()?;
    let local = tokio::task::LocalSet::new();
    local
        .block_on(&runtime, fs_rpc::stop_server(socket))
        .map_err(|e| Error(e.to_string()))
}
