name: windows
on:
  push:
  workflow_dispatch:
    inputs:
      cache: { type: boolean, default: true, description: "Rust cache on; false = cold run" }

permissions:
  contents: read

# A data package has no Cargo.toml: `cargo fmt --check` of the Windows gate would go red on it, so there the blueprint check (`--drift`) runs on Windows.
jobs:
  kind:
    runs-on: ubuntu-latest
    outputs:
      code: ${{open}} steps.look.outputs.code {{close}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - id: look
        run: if [ -f Cargo.toml ]; then echo "code=true" >> "$GITHUB_OUTPUT"; else echo "code=false" >> "$GITHUB_OUTPUT"; fi
  package:
    needs: kind
    if: needs.kind.outputs.code != 'true'
    runs-on: windows-latest
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: FreeSynergy/fs-documentation
          path: .fs-documentation
          persist-credentials: false
      - run: cargo install --git https://github.com/FreeSynergy/fs-release --tag {{release_tag}} --locked --root "$RUNNER_TEMP/fsbp" fs-blueprint
      - run: '"$RUNNER_TEMP/fsbp/bin/fs-blueprint" check --repo "$PWD" --talks "$PWD/.fs-documentation" --drift'
  windows:
    needs: kind
    if: needs.kind.outputs.code == 'true'
    uses: FreeSynergy/fs-release/.github/workflows/_windows-check.yml@{{release_tag}}
    with:
      cache: ${{open}} github.event_name != 'workflow_dispatch' || inputs.cache {{close}}
