[package]
name = "fs-{{program}}-server"
description = "The server of fs-{{program}} over a local socket (named pipe on Windows); it answers the handshake of fs-rpc and nothing else yet"
version.workspace = true
edition.workspace = true
license.workspace = true
authors.workspace = true
repository.workspace = true
rust-version.workspace = true

[dependencies]
fs-rpc = { git = "https://github.com/FreeSynergy/fs-rpc", tag = "{{pin_rpc}}" }
capnp = "0.27"
capnp-rpc = "0.27"
