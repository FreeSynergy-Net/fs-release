//! The start test of the generated program, on the real binary: the version, the help, a wrong word, and a server that answers the handshake.
//!
//! Tests: example-based. The server test starts `serve` on a socket of its own, waits for the handshake, ends the server through the protocol.

use std::io;
use std::process::{Command, Stdio};
use std::time::{Duration, Instant};

const EXE: &str = env!("CARGO_BIN_EXE_fs-{{program}}");

fn run(args: &[&str]) -> std::process::Output {
    Command::new(EXE).args(args).output().unwrap()
}

#[test]
fn the_version_is_printed_and_nothing_is_started() {
    for flag in ["--version", "-V"] {
        let out = run(&[flag]);
        assert!(out.status.success(), "{flag}: {}", String::from_utf8_lossy(&out.stderr));
        assert_eq!(String::from_utf8_lossy(&out.stdout).trim(), format!("fs-{{program}} {}", env!("CARGO_PKG_VERSION")));
    }
}

#[test]
fn the_help_is_printed_with_exit_code_0() {
    for flag in ["--help", "-h"] {
        let out = run(&[flag]);
        assert_eq!(out.status.code(), Some(0), "{flag}");
        assert!(String::from_utf8_lossy(&out.stdout).contains("fs-{{program}} serve"));
    }
}

#[test]
fn an_unknown_word_ends_with_2_and_a_message() {
    let out = run(&["--nonsense"]);
    assert_eq!(out.status.code(), Some(2));
    assert!(String::from_utf8_lossy(&out.stderr).contains("--nonsense"));
}

/// A folder only this user can enter: the server refuses a socket in a folder others can write to.
fn private_dir(name: &str) -> std::path::PathBuf {
    let dir = std::env::temp_dir().join(format!("{name}-{}", std::process::id()));
    std::fs::create_dir_all(&dir).unwrap();
    #[cfg(unix)]
    {
        use std::os::unix::fs::PermissionsExt;
        std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)).unwrap();
    }
    dir
}

#[test]
fn the_server_answers_the_handshake_and_ends_on_stop() {
    let dir = private_dir("fs-{{program}}-start-test");
    let socket = dir.join("server.sock");
    let mut server = Command::new(EXE)
        .arg("serve")
        .arg("--socket")
        .arg(&socket)
        .stdin(Stdio::null())
        .spawn()
        .unwrap();
    // the server is not started by the client here: the test started it, so the starter does nothing
    let nothing = || -> io::Result<()> { Ok(()) };
    let started = Instant::now();
    let mut last = Some("not tried".to_string());
    while last.is_some() && started.elapsed() < Duration::from_secs(60) {
        if let Ok(Some(status)) = server.try_wait() {
            panic!("the server ended by itself: {status}");
        }
        last = program_client::handshake(&socket, &nothing).err().map(|e| e.to_string());
        if last.is_some() {
            std::thread::sleep(Duration::from_millis(200));
        }
    }
    let stopped = program_client::stop(&socket);
    if last.is_some() || stopped.is_err() {
        let _ = server.kill();
    }
    let status = server.wait().unwrap();
    let _ = std::fs::remove_dir_all(&dir);
    assert!(last.is_none(), "no handshake: {last:?}");
    assert!(stopped.is_ok(), "stop: {stopped:?}");
    assert!(status.success(), "the server ended with {status}");
}
