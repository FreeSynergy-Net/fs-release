//! `fs-{{program}}-server`: the server of the program over a local socket. Today it answers the handshake of fs-rpc (`Control.version`, `Control.stop`) and nothing else.
//!
//! Pattern: Facade: reads the options, then serves until a signal or `Control.stop`.
#![deny(missing_docs)]
#![warn(clippy::pedantic)]

use std::ffi::OsString;
use std::io;
use std::path::Path;

use fs_rpc::{ServerIdentity, ServerOptions, run_until_signal_as};

/// The program name that `Control.version` carries; clients expect exactly this.
pub const PROGRAM: &str = "fs-{{program}}";

/// The name the socket is made from (the client says the same).
const SOCKET_PROGRAM: &str = "{{program}}";

/// The help text of `serve`.
pub const HELP: &str = "fs-{{program}} serve [--socket PATH] [--data DIR] [--actor IRI] [--instance DOMAIN] [--facet NAME]\nServes the handshake; stops on SIGTERM, Ctrl-C or Control.stop.";

/// Why `serve` ended without serving.
#[derive(Debug, PartialEq, Eq)]
pub enum ServeError {
    /// The words were wrong; the caller exits with 2.
    Usage(String),
    /// The server could not start or stopped with an error; exit with 1.
    Failed(String),
}

/// Serve until a signal arrives. `args` are the words after `serve`.
///
/// # Errors
/// [`ServeError::Usage`] for unknown or incomplete words, [`ServeError::Failed`] for everything else.
pub fn serve(args: impl IntoIterator<Item = OsString>) -> Result<(), ServeError> {
    let Some(options) = ServerOptions::parse(SOCKET_PROGRAM, args).map_err(ServeError::Usage)? else {
        println!("{HELP}");
        return Ok(());
    };
    run_on(&options.socket).map_err(|e| ServeError::Failed(e.to_string()))
}

/// Serve on `socket` until a signal or `Control.stop`. Runs its own runtime.
///
/// # Errors
/// The socket could not be bound, or work under way did not finish in time.
pub fn run_on(socket: &Path) -> io::Result<()> {
    // Name and version go to `Control.version`: a client of another version replaces this server (the fs-rpc handshake).
    let identity = ServerIdentity::new(PROGRAM, env!("CARGO_PKG_VERSION"));
    // The program has no contract yet: every call that is not `Control` is answered with `unimplemented`.
    run_until_signal_as(socket, identity, || async {
        Ok(capnp_rpc::new_broken_cap(capnp::Error::unimplemented(
            "this program offers no contract yet".to_owned(),
        )))
    })
}
