[package]
name = "fs-{{program}}-bin"
description = "fs-{{program}}: one command for the program (`serve` runs the server; without words it makes sure the server runs)"
version.workspace = true
edition.workspace = true
license.workspace = true
authors.workspace = true
repository.workspace = true
rust-version.workspace = true

[[bin]]
name = "fs-{{program}}"
path = "src/main.rs"

# The program-specific names stay in this file: the entry point says `program_server` and `program_client` (user decision 45).
[dependencies]
program_server = { package = "fs-{{program}}-server", path = "../fs-{{program}}-server" }
program_client = { package = "fs-{{program}}-client", path = "../fs-{{program}}-client" }
