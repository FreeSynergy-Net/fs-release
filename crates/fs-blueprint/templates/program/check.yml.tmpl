name: check
on:
  push:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: "${{open}} github.workflow {{close}}-${{open}} github.ref {{close}}"
  cancel-in-progress: true

# ONE caller for both kinds of repo: the reusable workflow of fs-release decides by itself. A repo with a Cargo.toml gets the code gates; a data package (scaffold.toml,
# no Cargo.toml) runs in data mode (identity, rust-rules, lock, files; the release-inputs and the release plan probe too), and `blueprint: warn` runs `fs-blueprint check --drift` in both.
# The pin is the tag of the skeleton (`skeleton::RELEASE_TAG`): it must be a release whose check.yml has the data mode.
jobs:
  check:
    uses: FreeSynergy-Net/fs-release/.github/workflows/check.yml@{{release_tag}}
    with:
      blueprint: warn
